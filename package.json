{
  "name": "redis-local",
  "version": "1.0.0",
  "description": "Ultra-lightweight Redis replacement for local development (Windows, macOS, Linux) with BullMQ, Lua scripting, Streams, and auto-persistence via npm/npx. Zero Docker required.",
  "main": "src/server.js",
  "bin": {
    "redis-local": "bin/redis-local.js",
    "redis-win": "bin/redis-win.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/redis-local.js",
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klority-io/redis-local.git"
  },
  "keywords": [
    "redis",
    "redis-local",
    "redis-server",
    "redis-win",
    "windows",
    "macos",
    "linux",
    "in-memory",
    "cache",
    "resp",
    "bullmq",
    "lua",
    "streams",
    "lightweight",
    "npx",
    "klority",
    "developer-tools"
  ],
  "author": "Klority <support@klority.com> (https://www.klority.com)",
  "contributors": [
    "Shanmuganathan Palanivel <shanmuganathan@vellsoft.in> (https://github.com/shanmuganathanvel)"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/klority-io/redis-local/issues"
  },
  "homepage": "https://www.klority.com",
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "wasmoon": "^1.16.0"
  }
}